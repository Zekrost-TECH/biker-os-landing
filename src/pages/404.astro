---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="notfound">
    <div class="container notfound-inner">
      <p class="notfound-code">404</p>
      <h1>Te perdiste en la ruta</h1>
      <p>La página que buscas no existe o fue movida. Vuelve al camino principal.</p>
      <a href="/" class="btn btn-primary btn-lg">Volver al inicio</a>
    </div>
  </main>

  <style>
    .notfound {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--space-16) 0;
    }
    .notfound-code {
      font-family: var(--font-display);
      font-size: var(--text-7xl);
      font-weight: 800;
      color: var(--accent);
      margin: 0;
      line-height: 1;
    }
    .notfound h1 {
      font-family: var(--font-display);
      font-size: var(--text-4xl);
      color: var(--text-primary);
      margin: var(--space-6) 0 var(--space-3);
    }
    .notfound p {
      color: var(--text-muted);
      margin-bottom: var(--space-8);
    }
  </style>
</BaseLayout>
