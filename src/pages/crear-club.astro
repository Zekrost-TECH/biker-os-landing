---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import MobileMenu from "../components/MobileMenu.astro";
import Footer from "../components/Footer.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "https://api.bikeros.co/api/v1";
const adminUrl = import.meta.env.PUBLIC_ADMIN_URL ?? "https://admin.bikeros.co";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

const checkIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

const benefits = [
  {
    title: "21 días gratis",
    text: "Plan Prueba completo: 15 miembros y 5 eventos al mes, sin costo.",
  },
  {
    title: "Sin tarjeta de crédito",
    text: "Pagas solo si decides quedarte, con tarjeta, Nequi o PSE.",
  },
  {
    title: "App móvil + panel web",
    text: "SOS en tiempo real, GPS en vivo y organización de rodadas desde el día 1.",
  },
  {
    title: "Cancela cuando quieras",
    text: "Sin contratos de permanencia. Conservas tus datos en modo lectura.",
  },
];
---

<BaseLayout>
  <Nav />
  <MobileMenu />

  <main class="signup-page">
    <section class="signup-hero">
      <div class="container">
        <span class="section-label">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
          Empieza gratis
        </span>
        <h1>Crea tu club y rueda <span class="highlight">en 2 minutos</span></h1>
        <p>
          Prueba BikerOS <strong>21 días gratis</strong>, sin tarjeta de crédito. Invita a tu manada,
          organiza la primera rodada y decide después si te quedas.
        </p>
      </div>
    </section>

    <section class="signup-form-section">
      <div class="container signup-grid">
        <div class="signup-benefits">
          <h3>Todo lo que incluye tu prueba</h3>
          <ul>
            {benefits.map((b) => (
              <li class="signup-benefit">
                <div class="signup-benefit-icon" set:html={checkIcon} />
                <div>
                  <strong>{b.title}</strong>
                  <span>{b.text}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <form id="signupForm" class="signup-card" novalidate>
          <h2>Crear mi club</h2>
          <p class="signup-sub">Completa tus datos y quédate listo para la primera rodada.</p>

          <div class="form-group">
            <label for="clubName">Nombre del club</label>
            <input type="text" id="clubName" name="clubName" placeholder="Ej: Iron Biker's Cartagena" required minlength="3" maxlength="80" autocomplete="organization" />
          </div>

          <div class="form-group">
            <label for="city">Ciudad <span class="optional">(opcional)</span></label>
            <input type="text" id="city" name="city" placeholder="Ej: Cartagena" maxlength="100" autocomplete="address-level2" />
          </div>

          <div class="form-group">
            <label for="email">Email del administrador</label>
            <input type="email" id="email" name="email" placeholder="capitan@club.co" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="Mínimo 8 caracteres" required minlength="8" autocomplete="new-password" />
          </div>

          {turnstileSiteKey && (
            <div class="form-group turnstile-wrap">
              <div id="turnstileContainer" class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-size="normal"></div>
            </div>
          )}

          <div id="formError" class="form-error" role="alert" hidden></div>

          <button type="submit" id="submitBtn" class="btn btn-lg btn-primary btn-block" disabled>
            Crear mi club gratis
          </button>

          <p class="signup-note">
            Al crear tu club aceptas nuestra <a href="/politica-de-privacidad" target="_blank">Política de privacidad</a>.
            Solo usamos tu email para proteger tu cuenta: nunca vemos los datos de tu tarjeta.
          </p>
        </form>
      </div>

      <div class="container">
        <div class="signup-meta reveal">
          <span class="signup-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
            21 días de prueba gratis
          </span>
          <span class="signup-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Sin tarjeta de crédito
          </span>
          <span class="signup-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            Cancela cuando quieras
          </span>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const apiUrl = import.meta.env.PUBLIC_API_URL ?? "https://api.bikeros.co/api/v1";
  const adminUrl = import.meta.env.PUBLIC_ADMIN_URL ?? "https://admin.bikeros.co";
  const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

  let turnstileToken: string | null = null;

  function showError(message: string) {
    const el = document.getElementById("formError");
    if (!el) return;
    el.textContent = message;
    el.hidden = false;
  }

  function clearError() {
    const el = document.getElementById("formError");
    if (el) el.hidden = true;
  }

  async function submit() {
    const btn = document.getElementById("submitBtn") as HTMLButtonElement;
    const clubName = (document.getElementById("clubName") as HTMLInputElement).value.trim();
    const city = (document.getElementById("city") as HTMLInputElement).value.trim();
    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("password") as HTMLInputElement).value;

    clearError();

    if (!clubName || !email || !password) {
      showError("Completa todos los campos obligatorios.");
      return;
    }
    if (password.length < 8) {
      showError("La contraseña debe tener al menos 8 caracteres.");
      return;
    }
    if (turnstileSiteKey && !turnstileToken) {
      showError("Completa la verificación de seguridad antes de continuar.");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Creando tu club...";

    try {
      const registerRes = await fetch(`${apiUrl}/auth/register`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: email.split("@")[0],
          email,
          password,
          ...(turnstileToken ? { turnstileToken } : {}),
        }),
      });
      const registerBody = await registerRes.json().catch(() => ({}));
      if (!registerRes.ok) {
        const msg =
          registerBody.statusCode === 409 || registerBody.message === "Ya existe una cuenta con este correo"
            ? "Ya existe una cuenta con este correo. Inicia sesión o usa otro."
            : registerBody.message || "No se pudo crear tu cuenta. Intenta de nuevo.";
        showError(msg);
        btn.disabled = false;
        btn.textContent = "Crear mi club gratis";
        return;
      }

      const accessToken = registerBody.access_token;

      const clubRes = await fetch(`${apiUrl}/clubs`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${accessToken}`,
        },
        body: JSON.stringify({ name: clubName, ...(city ? { city } : {}) }),
      });
      const clubBody = await clubRes.json().catch(() => ({}));
      if (!clubRes.ok) {
        const msg =
          clubBody.statusCode === 403
            ? "Ya tienes un club creado. Cada usuario administra un solo club."
            : clubBody.message || "No se pudo crear el club. Intenta de nuevo.";
        showError(msg);
        btn.disabled = false;
        btn.textContent = "Crear mi club gratis";
        return;
      }

      window.location.href = `${adminUrl}/login?welcome=1`;
    } catch {
      showError("Hubo un problema de conexión. Intenta de nuevo.");
      btn.disabled = false;
      btn.textContent = "Crear mi club gratis";
    }
  }

  window.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("signupForm");
    if (!form) return;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      void submit();
    });

    if (turnstileSiteKey) {
      const renderTurnstile = () => {
        const container = document.getElementById("turnstileContainer");
        if (!container || !(window as any).turnstile) return;
        (window as any).turnstile.render(container, {
          sitekey: turnstileSiteKey,
          theme: "dark",
          callback: (token: string) => {
            turnstileToken = token;
            clearError();
            const btn = document.getElementById("submitBtn") as HTMLButtonElement;
            btn.disabled = false;
          },
          "expired-callback": () => {
            turnstileToken = null;
          },
          "error-callback": () => {
            turnstileToken = null;
          },
        });
      };

      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad";
      (window as any).onTurnstileLoad = renderTurnstile;
      document.head.appendChild(script);
    } else {
      (document.getElementById("submitBtn") as HTMLButtonElement).disabled = false;
    }
  });
</script>
