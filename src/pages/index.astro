  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "BikerOS",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web, iOS, Android",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "COP",
      "description": "Plan de prueba gratuito de 21 días"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "ratingCount": "42"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Zekrost",
      "url": "https://zekrost.com",
      "email": "contacto@zekrost.com"
    },
    "description": "Plataforma SaaS multi-club para gestión de rodadas, tracking GPS en vivo y emergencias SOS para clubs de motociclismo en Colombia.",
    "inLanguage": "es-CO",
    "url": "https://biker-os.zekrost.com"
  }
  </script>


</head>

<body>
  <div class="scroll-progress" id="scrollProgress"></div>

  <noscript>
    <style>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
      }
      .hero-visual .phone-screen img {
        opacity: 1 !important;
      }
      .hero-visual .phone-screen img:not(:first-child) {
        display: none;
      }
    </style>
  </noscript>

  <div class="scroll-progress" id="scrollProgress"></div>

  <noscript>
    <style>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
      }
      .hero-visual .phone-screen img {
        opacity: 1 !important;
      }
      .hero-visual .phone-screen img:not(:first-child) {
        display: none;
      }
    </style>
  </noscript>

  <!-- SVG gradients / filters for reuse -->
  <svg width="0" height="0" style="position: absolute;">
    <defs>
      <linearGradient id="routeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#38BDF8" stop-opacity="0"/>
        <stop offset="50%" stop-color="#38BDF8" stop-opacity="1"/>
        <stop offset="100%" stop-color="#38BDF8" stop-opacity="0"/>
      </linearGradient>
    </defs>
  </svg>

  <!-- NAVIGATION -->
  <nav class="nav" id="nav">
    <div class="container">
      <a href="#" class="nav-logo" aria-label="BikerOS inicio">
        <img src="/images/BikerOS_Imagotipo_Negativo.webp" alt="BikerOS" height="48" />
      </a>

      <div class="nav-links">
        <a href="#funcionalidades">Funcionalidades</a>
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#precios">Precios</a>
        <a href="#faq">FAQ</a>
      </div>

      <div class="nav-cta">
        <a href="#precios" class="btn btn-ghost">Ver planes</a>
        <a href="#" class="btn btn-primary btn-whatsapp" data-cta-whatsapp>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/>
            <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z"/>
            <path d="M14 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z"/>
            <path d="M9.5 13.5c.5 1 1.5 1.5 2.5 1.5s2-.5 2.5-1.5"/>
          </svg>
          Crear mi club
        </a>
        <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Abrir menú">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="#funcionalidades" class="mobile-link">Funcionalidades</a>
    <a href="#como-funciona" class="mobile-link">Cómo funciona</a>
    <a href="#precios" class="mobile-link">Precios</a>
    <a href="#faq" class="mobile-link">FAQ</a>
    <a href="#" class="btn btn-primary btn-whatsapp" data-cta-whatsapp>Crear mi club gratis</a>
  </div>

  <!-- HERO SECTION -->
  <section class="hero" id="inicio">
    <div class="route-line">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0 60 C 150 120, 300 0, 450 60 S 750 120, 900 60 S 1050 0, 1200 60" />
      </svg>
    </div>
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
            <path d="M2 12h20"/>
          </svg>
          Hecho en Colombia para motociclistas
        </div>
        <h1>
          El sistema operativo de tu
          <span class="highlight">club de motos</span>
        </h1>
        <p>
          Organiza rodadas, protege a tu manada con <strong>SOS en tiempo real</strong> y gestiona tu club como un profesional. Todo en una sola plataforma.
        </p>
        <div class="hero-ctas">
          <a href="#" class="btn btn-lg btn-whatsapp" data-cta-whatsapp>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/>
              <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z"/>
              <path d="M14 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z"/>
              <path d="M9.5 13.5c.5 1 1.5 1.5 2.5 1.5s2-.5 2.5-1.5"/>
            </svg>
            Crear mi club gratis
          </a>
          <a href="#precios" class="btn btn-lg btn-secondary">Ver planes</a>
        </div>
        <div class="hero-trust">
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            </svg>
            <span>21 días de prueba gratis</span>
          </div>
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            </svg>
            <span>Sin tarjeta de crédito</span>
          </div>
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            </svg>
            <span>Cancela cuando quieras</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="float-card float-card-sos">
          <h4>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/>
              <path d="M12 9v4"/>
              <path d="M12 17h.01"/>
            </svg>
            SOS activado
          </h4>
          <p>Ubicación enviada a la manada</p>
        </div>
        <div class="float-card float-card-track">
          <h4>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            GPS en vivo
          </h4>
          <p>3 pilotos cerca de ti</p>
        </div>
        <div class="phone" id="heroPhone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <img src="/screenshots/home.png" loading="lazy" alt="Dashboard de BikerOS" class="active">
            <img src="/screenshots/eventos.png" loading="lazy" alt="Lista de rodadas">
            <img src="/screenshots/sos.png" loading="lazy" alt="Emergencia SOS">
            <img src="/screenshots/perfil.png" loading="lazy" alt="Perfil del piloto">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee">
    <div class="marquee-track">
      <div class="marquee-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
