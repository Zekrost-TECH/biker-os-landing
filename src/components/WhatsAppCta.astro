---
import { site } from "../data/site";

interface Props {
  label: string;
  className?: string;
  showIcon?: boolean;
  iconSize?: number;
}

const { label, className = "btn btn-primary btn-whatsapp", showIcon = true, iconSize = 18 } = Astro.props;
---

<a href={site.whatsappUrl} class={className} data-cta-whatsapp>
  {showIcon && (
    <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/>
      <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z"/>
      <path d="M14 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z"/>
      <path d="M9.5 13.5c.5 1 1.5 1.5 2.5 1.5s2-.5 2.5-1.5"/>
    </svg>
  )}
  <span>{label}</span>
</a>
