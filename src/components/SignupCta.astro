---
interface Props {
  label: string;
  className?: string;
  iconSize?: number;
}

const { label, className = "btn btn-primary", iconSize = 18 } = Astro.props;
---

<a href="/crear-club" class={className} data-cta-signup>
  <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
    <circle cx="9" cy="7" r="4"/>
    <path d="M19 8v6"/>
    <path d="M22 11h-6"/>
  </svg>
  <span>{label}</span>
</a>
